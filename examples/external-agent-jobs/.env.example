# ArcLayer Agent Jobs Example

ARCLAYER_BASE_URL=http://localhost:3000
ARCLAYER_API_KEY=your-api-key
JOB_TYPE=generic_analysis
BUYER_AGENT_ID=agent_buyer_001
WORKER_ID=agent_worker_001
PROVIDER_AGENT_ID=agent_provider_001
VERIFIER_AGENT_ID=agent_verifier_001

# Polling interval in ms (default 5000)
JOB_POLL_INTERVAL_MS=5000

# Set to true to actually execute x402 on-chain payment during settle
LIVE_JOB_SETTLEMENT=false

# Required for live settlement
X402_PAYER_PRIVATE_KEY=
