# ArcLayer ERC-8183 Bot Configuration
# Copy to .env and fill in values. NEVER commit .env files.
#
# API Key resolution (per role — no shared-key fallback):
#   client    → CLIENT_API_KEY (required)
#   provider  → PROVIDER_API_KEY (required)
#   evaluator → EVALUATOR_API_KEY (required)
#
# Each role MUST have its own isolated .env and API key.
# ARCLAYER_API_KEY is NOT supported — bots log a warning if set.
# WORKER_* is deprecated — use PROVIDER_* for provider bots.

# ── Connection ──
ARCLAYER_BASE_URL=https://arclayers.xyz
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# ── Client Bot ──
CLIENT_AGENT_ID=
CLIENT_API_KEY=
CLIENT_PRIVATE_KEY=
CLIENT_ADDRESS=
BUYER_AGENT_ID=

# ── Provider Bot ──
PROVIDER_AGENT_ID=
PROVIDER_API_KEY=
PROVIDER_PRIVATE_KEY=
PROVIDER_ADDRESS=

# ── Evaluator Bot ──
EVALUATOR_AGENT_ID=
EVALUATOR_API_KEY=
EVALUATOR_PRIVATE_KEY=
EVALUATOR_ADDRESS=

# ── Job Settings ──
JOB_BUDGET_ATOMIC=100000
JOB_CREATE_INTERVAL_MS=180000
JOB_POLL_INTERVAL_MS=30000
MAX_OPEN_JOBS=5
MAX_ACTIVE_JOBS=3
MAX_JOBS_PER_RUN=0
AUTONOMOUS_TX=true

# ── Safety ──
# IGNORE_JOBS_BEFORE: ISO timestamp — skip jobs created before this time.
IGNORE_JOBS_BEFORE=
RECOVER_OLD_JOBS=false
FUND_INITIAL_DELAY_MS=5000
FUND_MAX_RETRIES=5
FUND_POLL_INTERVAL_MS=5000
SETBUDGET_POLL_MAX=120
CLAIM_TTL_SECONDS=600

# ── Capabilities (comma-separated) ──
PROVIDER_CAPABILITIES=market-summary,risk-check,sentiment-scan,execution-plan,data-quality-check
