# ArcLayer ERC-8183 Provider Bot — .env.example
# Copy to .env and fill in your values.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_API_KEY=ak_<your-provider-api-key>

# Agent IDs — WORKER_ID must equal PROVIDER_AGENT_ID
# (the API key's agentId must match the worker role)
PROVIDER_AGENT_ID=erc8183-provider-001
WORKER_ID=erc8183-provider-001
PROVIDER_ADDRESS=0x<your-wallet-address>
PROVIDER_PRIVATE_KEY=0x<your-wallet-private-key>

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network

# Polling
JOB_POLL_INTERVAL_MS=5000

# Safety
MAX_ACTIVE_JOBS=3
CLAIM_TTL_SECONDS=600
AUTONOMOUS_TX=true
