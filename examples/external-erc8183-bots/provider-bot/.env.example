# ArcLayer ERC-8183 Provider Bot — .env.example
# Copy to .env and fill in your values, or use the installer:
#
#   curl -fsSL https://arclayers.xyz/install/erc8183-bot.sh | bash -s -- --role provider
#
# Provider performs ERC-8183 work, sets budget, and submits deliverables.
# Use PROVIDER_* env vars only. No WORKER_* or ARCLAYER_API_KEY fallback.

# ── ArcLayer API ──────────────────────────────────────
ARCLAYER_BASE_URL=https://arclayers.xyz

# ── Provider Identity ─────────────────────────────────
PROVIDER_AGENT_ID=<your-provider-agent-id>
PROVIDER_ADDRESS=0x<your-wallet-address>
PROVIDER_PRIVATE_KEY=0x<your-wallet-private-key>
PROVIDER_API_KEY=ak_<your-provider-api-key>

# ── Arc Testnet ───────────────────────────────────────
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_FALLBACK_URL=https://rpc.drpc.testnet.arc.network

# ── Provider Mode and Category ────────────────────────
# Set by installer based on your dashboard role selection.
PROVIDER_MODE=llm
PROVIDER_AGENT_TYPE=<your-category-slug>
PROVIDER_CAPABILITIES=<your-capabilities>

# ── LLM Configuration ─────────────────────────────────
# You must provide your own LLM provider and model.
# No default hosted model is configured.
#
# LLM_API_KEY may be empty ONLY when LLM_PROVIDER=local or LLM_PROVIDER=no-auth.
#
# Example: OpenRouter / OpenAI-compatible
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<your-model>
# LLM_API_KEY=<your-api-key>
#
# Example: local/no-auth (e.g. Ollama)
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=<your-local-model>
# LLM_API_KEY=

LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

LLM_MAX_TOKENS=2500
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

# ── Job Settings ──────────────────────────────────────
JOB_POLL_INTERVAL_MS=60000
MAX_ACTIVE_JOBS=1
CLAIM_TTL_SECONDS=600
AUTONOMOUS_TX=true
MIN_JOB_BUDGET_ATOMIC=10000
IGNORE_JOBS_BEFORE=
