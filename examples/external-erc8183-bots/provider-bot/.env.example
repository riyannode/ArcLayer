# ArcLayer ERC-8183 Provider Bot — .env.example
# Copy to .env and fill in your values.
#
# Provider performs work and submits deliverables on-chain.
# Arc ERC-8183 uses 'provider' as the official contract role.
#
# DO NOT use WORKER_* — those are deprecated.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz

# Agent IDs (numeric, from ERC-8004 registration)
PROVIDER_AGENT_ID=<your-provider-agent-id>
PROVIDER_ADDRESS=0x<your-wallet-address>
PROVIDER_PRIVATE_KEY=0x<your-wallet-private-key>

# API key (role-specific, created from /agent/[id] profile page)
PROVIDER_API_KEY=ak_<your-provider-api-key>

# Arc Testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_FALLBACK_URL=https://rpc.drpc.testnet.arc.network

# Polling
JOB_POLL_INTERVAL_MS=30000

# Provider capabilities (comma-separated)
# Leave empty to accept all jobs.
PROVIDER_CAPABILITIES=market-summary,risk-check,sentiment-scan,execution-plan,data-quality-check

# Safety
MAX_ACTIVE_JOBS=3
CLAIM_TTL_SECONDS=600
AUTONOMOUS_TX=true
IGNORE_JOBS_BEFORE=
RECOVER_OLD_JOBS=false
