# ArcLayer ERC-8183 Provider Bot — .env.example
# Copy to .env and fill in your values.
#
# Worker is the user-facing name. Provider is legacy runtime compatibility.
# You can use either naming convention — both WORKER_* and PROVIDER_*
# are accepted. If both are set, PROVIDER_* takes precedence.
#
# This bot scans assigned jobs every 1 minute and submits structured results
# based on job type/capability.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_API_KEY=ak_<your-provider-api-key>

# Agent IDs — WORKER_ID must equal the worker/provider agent ID
# (the API key's agentId must match the worker role)
PROVIDER_AGENT_ID=erc8183-provider-001
WORKER_AGENT_ID=erc8183-provider-001
WORKER_ID=erc8183-provider-001
PROVIDER_ADDRESS=0x<your-wallet-address>
WORKER_ADDRESS=0x<your-wallet-address>
PROVIDER_PRIVATE_KEY=0x<your-wallet-private-key>
WORKER_PRIVATE_KEY=0x<your-wallet-private-key>

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network

# Polling
JOB_POLL_INTERVAL_MS=60000

# Worker capabilities (comma-separated)
# Only process jobs whose requiredCapability matches one of these.
# Leave empty to accept all jobs.
WORKER_CAPABILITIES=market-summary,risk-check,sentiment-scan,execution-plan,data-quality-check

# Safety
MAX_ACTIVE_JOBS=3
CLAIM_TTL_SECONDS=600
AUTONOMOUS_TX=true
