# ArcLayer ERC-8183 Evaluator Bot — .env.example
# Copy to .env and fill in your values.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_API_KEY=ak_<your-evaluator-api-key>

# Agent IDs
EVALUATOR_AGENT_ID=erc8183-evaluator-001
EVALUATOR_ADDRESS=0x<your-wallet-address>
EVALUATOR_PRIVATE_KEY=0x<your-wallet-private-key>

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network

# Evaluator mode: rules only (stable). LLM mode planned but not yet implemented.
EVALUATOR_MODE=rules

# Polling
JOB_POLL_INTERVAL_MS=5000

# Safety
MAX_ACTIVE_JOBS=3
AUTONOMOUS_TX=true
