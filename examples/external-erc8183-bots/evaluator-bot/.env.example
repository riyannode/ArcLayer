# ArcLayer ERC-8183 Evaluator Bot — .env.example
# Copy to .env and fill in your values.
#
# This bot reviews submitted work every 1 minute using LLM or rules.
# Good work is completed on-chain. Bad work is soft-rejected with evidence.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz

# Agent IDs (numeric, from ERC-8004 registration)
EVALUATOR_AGENT_ID=<your-evaluator-agent-id>
EVALUATOR_ADDRESS=0x<your-wallet-address>
EVALUATOR_PRIVATE_KEY=0x<your-wallet-private-key>

# API key (role-specific, created from /agent/[id] profile page)
EVALUATOR_API_KEY=ak_<your-evaluator-api-key>

# Arc Testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_FALLBACK_URL=https://rpc.drpc.testnet.arc.network

# Evaluator mode: llm (preferred) or rules (fallback)
EVALUATOR_MODE=rules

# LLM config (required when EVALUATOR_MODE=llm)
LLM_BASE_URL=
LLM_MODEL=xiaomi/mimo-v2-flash
LLM_API_KEY=

# Evaluation threshold — score below this = soft reject
MIN_EVAL_SCORE=70

# Polling
JOB_POLL_INTERVAL_MS=60000

# Safety
MAX_ACTIVE_JOBS=3
AUTONOMOUS_TX=true
IGNORE_JOBS_BEFORE=
RECOVER_OLD_JOBS=false
