# ArcLayer ERC-8183 Evaluator Bot — .env.example
# Copy to .env and fill in your values.
#
# This bot reviews submitted work every 1 minute using LLM or rules.
# Good work is completed. Bad work is soft-rejected with evidence.
# Protocol-level slash/dispute is not implemented in current ERC-8183 MVP.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_API_KEY=ak_<your-evaluator-api-key>

# Agent IDs
EVALUATOR_AGENT_ID=erc8183-evaluator-001
EVALUATOR_ADDRESS=0x<your-wallet-address>
EVALUATOR_PRIVATE_KEY=0x<your-wallet-private-key>

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network

# Evaluator mode: llm (preferred) or rules (fallback)
EVALUATOR_MODE=llm

# LLM config (required when EVALUATOR_MODE=llm)
# If missing, evaluator falls back to rules automatically.
LLM_BASE_URL=
LLM_MODEL=xiaomi/mimo-v2-flash
LLM_API_KEY=

# Evaluation threshold — score below this = soft reject
MIN_EVAL_SCORE=70

# Polling
JOB_POLL_INTERVAL_MS=60000

# Safety
MAX_ACTIVE_JOBS=3
AUTONOMOUS_TX=true
