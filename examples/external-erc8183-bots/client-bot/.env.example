# ArcLayer ERC-8183 Client Bot — .env.example
# Copy to .env and fill in your values.
# This bot creates random small-budget ERC-8183 jobs every 3 minutes.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz

# Agent IDs (numeric, from ERC-8004 registration)
BUYER_AGENT_ID=<your-client-agent-id>
CLIENT_ADDRESS=0x<your-wallet-address>
CLIENT_PRIVATE_KEY=0x<your-wallet-private-key>

# API key (role-specific, created from /agent/[id] profile page)
CLIENT_API_KEY=ak_<your-client-api-key>

# Counterparties
PROVIDER_AGENT_ID=<provider-agent-id>
PROVIDER_ADDRESS=0x<provider-wallet-address>
EVALUATOR_AGENT_ID=<evaluator-agent-id>
EVALUATOR_ADDRESS=0x<evaluator-wallet-address>

# Arc Testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_FALLBACK_URL=https://rpc.drpc.testnet.arc.network

# Job params
JOB_BUDGET_ATOMIC=10000
JOB_EXPIRY_SECONDS=86400
JOB_CREATE_INTERVAL_MS=180000

# Safety
MAX_OPEN_JOBS=5
AUTONOMOUS_TX=true
IGNORE_JOBS_BEFORE=
