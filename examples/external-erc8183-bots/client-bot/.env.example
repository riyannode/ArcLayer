# ArcLayer ERC-8183 Client Bot — .env.example
# Copy to .env and fill in your values.

# ArcLayer API
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_API_KEY=ak_<your-client-api-key>

# Agent IDs
BUYER_AGENT_ID=erc8183-client-001
CLIENT_ADDRESS=0x<your-wallet-address>
CLIENT_PRIVATE_KEY=0x<your-wallet-private-key>

# Counterparties
PROVIDER_AGENT_ID=erc8183-provider-001
PROVIDER_ADDRESS=0x<provider-wallet-address>
EVALUATOR_AGENT_ID=erc8183-evaluator-001
EVALUATOR_ADDRESS=0x<evaluator-wallet-address>

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network

# Job params
JOB_BUDGET_ATOMIC=1000000
JOB_EXPIRY_SECONDS=86400
JOB_CREATE_INTERVAL_MS=60000

# Safety
MAX_JOBS_PER_RUN=1
MAX_OPEN_JOBS=5
AUTONOMOUS_TX=true
