# Evaluator Runtime Bot Environment
# Copy to .env and fill in your values. NEVER commit .env files.
#
# IMPORTANT: Create a DEDICATED evaluator wallet.
# Do NOT reuse client, provider, or main wallet keys.

# ── ArcLayer MCP ─────────────────────────────────────────────────────────
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_MCP_TOKEN=arc_mcp_sess_your_token_here
ARCLAYER_NETWORK=arc-testnet

# ── Evaluator Wallet ─────────────────────────────────────────────────────
# Dedicated evaluator EOA address (checksummed)
EVALUATOR_ADDRESS=0xYourDedicatedEvaluatorAddress

# Evaluator private key — LOCAL ONLY, never sent to ArcLayer
EVALUATOR_PRIVATE_KEY=0xYourEvaluatorPrivateKey

# Signer mode: legacy-eoa (only mode supported in this PR)
# Future: circle-dcw-sca, agent-wallet-delegated (returns not_configured)
EVALUATOR_SIGNER_MODE=legacy-eoa

# ── LLM Configuration ───────────────────────────────────────────────────
LLM_PROVIDER=openai

# LLM API base URL (no trailing slash)
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:    http://127.0.0.1:11434/v1  (local only, not for production)
LLM_BASE_URL=https://api.openai.com/v1

# LLM model name
EVALUATOR_MODEL=gpt-4.1-mini

# LLM API key (also accepts OPENAI_API_KEY as fallback)
LLM_API_KEY=sk-your-openai-api-key

# ── Evaluator Behavior ──────────────────────────────────────────────────
# Auto-complete jobs when LLM returns decision=complete with confidence >= threshold
EVALUATOR_AUTO_COMPLETE=true

# Auto-reject jobs when LLM returns decision=reject with confidence >= threshold
EVALUATOR_AUTO_REJECT=true

# Minimum confidence threshold (0.0-1.0) for signing complete/reject
EVALUATOR_MIN_CONFIDENCE=0.80

# Max jobs to process per poll loop (prevents overload)
EVALUATOR_MAX_JOBS_PER_LOOP=3

# Poll interval in ms (default: 15000)
POLL_INTERVAL_MS=15000

# ── Optional LLM tuning ─────────────────────────────────────────────────
# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_MS=60000

# ── Contract Address (usually auto-resolved) ────────────────────────────
# ERC8183_CONTRACT_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
