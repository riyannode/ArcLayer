# ArcLayer Agent Commerce Gate — Environment Variables
# Copy to .env and fill in your values.

# ArcLayer backend URL (optional, defaults to https://arclayers.xyz)
# Code reads ARCLAYER_BASE_URL first, falls back to ARCLAYER_API_URL
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_AGENT_ID=your-agent-id
ARCLAYER_API_KEY=your-api-key

# ── Circle x402 Payer ────────────────────────────────────────────────
X402_PAYER_PRIVATE_KEY=0x...
X402_GATEWAY_ID=your-gateway-id
X402_GATEWAY_BASE_URL=https://gateway.circle.com

# ── Upstream (for buyer roles: analyzer, evaluator, executor) ────────
UPSTREAM_AGENT_ID=upstream-agent-id
UPSTREAM_ROLE=oracle

# ── Bot Identity ─────────────────────────────────────────────────────
BOT_ROLE=oracle
BOT_MARKET=btc-15m

# ── LLM (for analyzer/evaluator/executor) ────────────────────────────
LLM_API_URL=https://api.june.so
LLM_API_KEY=your-llm-api-key
LLM_MODEL=xiaomi/mimo-v2-flash

# ── Loop Config ──────────────────────────────────────────────────────
LOOP_INTERVAL=300
LOOP_MAX_RUNS=0

# ── Optional: High-Frequency / Stress (disabled by default) ─────────
HI_FREQ_ENABLED=false
STRESS_MODE=false
PAY_PER_MINUTE=1
