# ArcLayer backend
ARCLAYER_BASE_URL=https://arclayers.xyz

# Bot identity. This is per bot/agent.
# A2A_API_KEY_PEPPER is backend-only. Do not put it here.
ARCLAYER_AGENT_ID=25883
ARCLAYER_API_KEY=ak_xxx

# Circle x402 payer wallet
X402_PAYER_PRIVATE_KEY=0x...
X402_GATEWAY_CHAIN=arcTestnet
X402_GATEWAY_DEPOSIT_AMOUNT=1.00

# Circle gate config
CIRCLE_GATE_ROUTE=/api/x402/circle-agent-gate
AGENT_CATEGORY=prediction-market-bots
AGENT_ROLE=oracle
AGENT_SCOPE=hft_session
MARKET_ID=btc-15m
RUNTIME_ID=circle-oracle-01

# Upstream — set for buyer bots (analyzer, evaluator, executor)
# Oracle has no upstream (it's the data source)
UPSTREAM_AGENT_ID=
UPSTREAM_ROLE=

# Independent run config
SESSION_ID=
BOT_CONFIG=bot.config.example.json
LLM_PROVIDER=mock
LLM_MODEL=mock-llm
