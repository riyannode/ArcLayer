# Circle Commerce Bots - Hi-Frequency Config
# Copy to .env and fill in real keys

# LLM (all bots share)
LLM_MODEL=xiaomi/mimo-v2-flash

# Oracle (hermes-oracle)
ARCLAYER_API_KEY_ORACLE=ak_xxx
BOT_PRIVATE_KEY_ORACLE=0x...

# Analyzer (apollo-analyzer)
ARCLAYER_API_KEY_ANALYZER=ak_xxx
BOT_PRIVATE_KEY_ANALYZER=0x...

# Evaluator (ignia-evaluator)
ARCLAYER_API_KEY_EVALUATOR=ak_xxx
BOT_PRIVATE_KEY_EVALUATOR=0x...

# Executor (budu-executor)
ARCLAYER_API_KEY_EXECUTOR=ak_xxx
BOT_PRIVATE_KEY_EXECUTOR=0x...
