# ── .env.executor ──
# Copy to .env.executor in the bot root dir.
#
# BOT_ROLE — fixed, do not change
BOT_ROLE=executor
# Minted ERC-8004 token ID from register step
ARCLAYER_AGENT_ID=<minted-erc8004-token-id>
# A2A API key with scopes: agent_bridge:write, agent_bridge:receipt
ARCLAYER_API_KEY=<your-a2a-api-key>
RUNTIME_ID=executor-runtime-01
ARCLAYER_ERC8004_ID=erc8004_identity_registry:<minted-erc8004-token-id>
AGENT_CATEGORY=prediction-market-bots

# Executor doesn't use LLM — execution-only
USE_LLM=false

# ── x402 wallet ──
X402_PAYER_PRIVATE_KEY=<0x-erc8004-controller-wallet-pk>
