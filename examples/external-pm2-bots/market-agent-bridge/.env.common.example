# ── .env.common ──
# Copy to .env.common and fill values.
# Shared across all bot roles — sourced by each bot on startup.

# ArcLayer console base URL (NO www — 308 redirect strips auth headers)
ARCLAYER_BASE_URL=https://arclayers.xyz

# Agent category for indexing / discovery
AGENT_CATEGORY=prediction-market-bots

# Execution mode: DRY_RUN | LIVE
MARKET_EXECUTION_MODE=DRY_RUN

# Protocol tx target: ARC_TESTNET | ARC_MAINNET
PROTOCOL_TX_MODE=ARC_TESTNET

# ── x402 autopay ──────────────────────────────────────────────
# Enable autonomous x402 payment per cycle
X402_AUTOPAY=true
# Set true to fail cycle if autopay fails
X402_AUTOPAY_REQUIRED=false
# Payment scope fed to bridge-access endpoint
X402_SCOPE=external_trace

# ── Scheduler ─────────────────────────────────────────────────
# Bot cycle interval in ms (default: 15 min)
BOT_INTERVAL_MS=900000

# ── LLM defaults ──────────────────────────────────────────────
# Per-role overrides in .env.<role>
LLM_TIMEOUT_MS=30000

# ── Heartbeat auth (for prediction-market-heartbeat only) ─────
# Each bot uses its own ARCLAYER_API_KEY from .env.<role>.
# The heartbeat process needs separate auth to post presence.
#
# Option A: Per-agent keys (recommended for multi-agent setups)
#   PREDICTION_AGENT_IDS="<oracle-id>:My Oracle,<analyzer-id>:My Analyzer,<evaluator-id>:My Evaluator,<executor-id>:My Executor"
#   PREDICTION_AGENT_KEYS="<oracle-id>:ak_xxx,<analyzer-id>:ak_xxx,<evaluator-id>:ak_xxx,<executor-id>:ak_xxx"
#
# Option B: Single global token (simpler, one key covers all agents)
#   A2A_LIVE_EVENTS_TOKEN=ak_xxx
#
# Generate keys via: POST /api/a2a/keys
# Required scopes: agent_bridge:write, agent_bridge:receipt, live_events:write, presence:write
# Or use: node scripts/regen-keys.mjs (set private keys as env vars first)

# ── Wallet ────────────────────────────────────────────────────
# Each bot .env.<role> must have:
#   X402_PAYER_PRIVATE_KEY=<0x-prefixed-erc8004-controller-wallet-pk>
# Wallet must hold min ~20 USDC on Arc testnet for x402 payments.
