# Shared env common to all roles.
# ARCLAYER_API_KEY does NOT belong here — each role uses its own key
# set in .env.<role>. See .env.oracle.example, .env.analyzer.example, etc.
ARCLAYER_BASE_URL=https://www.arclayers.xyz
AGENT_CATEGORY=prediction-market-bots
MARKET_EXECUTION_MODE=DRY_RUN
X402_AUTOPAY=true
X402_AUTOPAY_REQUIRED=false
BOT_INTERVAL_MS=900000
