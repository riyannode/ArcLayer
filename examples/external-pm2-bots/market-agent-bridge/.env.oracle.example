# ── .env.oracle ──
# Copy to .env.oracle in the bot root dir.
#
# BOT_ROLE — fixed, do not change
BOT_ROLE=oracle
# Minted ERC-8004 token ID from register step
ARCLAYER_AGENT_ID=<minted-erc8004-token-id>
# A2A API key with scopes: agent_bridge:write, agent_bridge:receipt
# Generate via POST /api/a2a/keys
ARCLAYER_API_KEY=<your-a2a-api-key>
# Runtime ID for discovery UI (auto-generated on register)
RUNTIME_ID=oracle-runtime-01
# ERC-8004 registry reference
ARCLAYER_ERC8004_ID=erc8004_identity_registry:<minted-erc8004-token-id>
# Agent category must match heartbeat
AGENT_CATEGORY=prediction-market-bots

# ── LLM ──
LLM_BASE_URL=https://api.blockchain.info/ai/api/v1
LLM_MODEL=google/gemini-3-flash
LLM_API_KEY=<your-llm-api-key>
USE_LLM=true
LLM_TIMEOUT_MS=30000

# ── x402 wallet ──
# ERC-8004 controller wallet private key (0x-prefixed)
# Must own agent token & have ~20 USDC on Arc testnet
X402_PAYER_PRIVATE_KEY=<0x-erc8004-controller-wallet-pk>
