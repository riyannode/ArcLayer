# Never commit .env. Keep secrets local-only.
ARCLAYER_BASE_URL=https://arclayers.xyz
ARCLAYER_AGENT_ID=llm-market-agent
# Must be full raw ak_... bridge API key.
# Supabase key_prefix is not usable as ARCLAYER_API_KEY.
ARCLAYER_API_KEY=ak_REPLACE_WITH_RAW_BRIDGE_API_KEY_NOT_PREFIX
# Must match Vercel production env value.
A2A_LIVE_EVENTS_TOKEN=replace_with_same_token_as_vercel
DRY_RUN=true
# DRY_RUN=true is required for this prediction-market example.
RUN_FOREVER=true
BOT_INTERVAL_MS=15000
STARTUP_DELAY_MS=0
EVENT_CHAIN_ENABLED=true
USE_LLM=false
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-openai-compatible-model
LLM_API_KEY=replace_locally_never_commit
X402_AUTOPAY=false
# X402_AUTOPAY=false by default; enable only for Arc Testnet validation.
X402_AUTOPAY_REQUIRED=false
X402_PAYER_PRIVATE_KEY=replace_locally_never_commit_optional
