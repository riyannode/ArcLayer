# Provider Runtime Bot Environment
# Copy to .env and fill in your values. NEVER commit .env files.

# ArcLayer MCP endpoint
ARCLAYER_BASE_URL=https://arclayers.xyz

# MCP session token (created via console UI or MCP tools)
ARCLAYER_MCP_TOKEN=arc_mcp_sess_your_token_here

# Provider agent ID (ERC-8004 token ID)
ARCLAYER_AGENT_ID=your_agent_id

# Provider wallet address (checksummed)
PROVIDER_ADDRESS=0xYourProviderAddress

# Provider private key — LOCAL ONLY, never sent to ArcLayer
# Only needed for signing transactions (setBudget, submit)
PROVIDER_PRIVATE_KEY=0xYourPrivateKey

# Bot mode
PROVIDER_MODE=provider

# Auto-apply to open/global jobs (default: false)
# If true, bot will apply to matching open jobs automatically
PROVIDER_AUTO_APPLY_OPEN_JOBS=false

# Max quote in USDC for auto-apply (optional)
PROVIDER_MAX_QUOTE_USDC=10.0

# Comma-separated capabilities for auto-apply (optional)
PROVIDER_CAPABILITIES=data-analysis,market-summary

# Poll interval in ms (default: 15000)
POLL_INTERVAL_MS=15000

# ── LLM Configuration (required for real deliverable generation) ────────────
# LLM config is required. Bot exits at startup if LLM_PROVIDER, LLM_BASE_URL, or LLM_MODEL is missing.
# LLM_API_KEY is required unless provider is local/no-auth.
# For real jobs, these MUST be configured.

# LLM provider label (e.g. openai, anthropic, local, no-auth)
LLM_PROVIDER=openai

# LLM API base URL (no trailing slash)
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:    http://127.0.0.1:11434/v1  (local only, not for production)
LLM_BASE_URL=

# LLM model name
# Examples: gpt-4o, deepseek/deepseek-v4-flash, claude-sonnet-4-20250514
LLM_MODEL=

# LLM API key (required unless LLM_PROVIDER=local or no-auth)
LLM_API_KEY=

# ── Optional LLM tuning ────────────────────────────────────────────────────
# LLM_MAX_TOKENS=2500
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_MS=60000
# LLM_JSON_REPAIR_RETRIES=1

# ── Provider skill configuration (optional) ─────────────────────────────────
# PROVIDER_AGENT_TYPE=other
# PROVIDER_SKILL=auto
# PROVIDER_CUSTOM_SKILL_PATH=/absolute/path/to/custom-skill.md
