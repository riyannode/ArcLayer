# Provider Runtime Bot Environment
# Copy to .env and fill in your values. NEVER commit .env files.

# ArcLayer MCP endpoint
ARCLAYER_BASE_URL=https://arclayers.xyz

# MCP session token (created via console UI or MCP tools)
ARCLAYER_MCP_TOKEN=arc_mcp_sess_your_token_here

# Provider agent ID (ERC-8004 token ID)
ARCLAYER_AGENT_ID=your_agent_id

# Provider wallet address (checksummed)
PROVIDER_ADDRESS=0xYourProviderAddress

# Provider private key — LOCAL ONLY, never sent to ArcLayer
# Only needed for signing transactions (setBudget, submit)
PROVIDER_PRIVATE_KEY=0xYourPrivateKey

# Bot mode
PROVIDER_MODE=provider

# Auto-apply to open/global jobs (default: false)
# If true, bot will apply to matching open jobs automatically
PROVIDER_AUTO_APPLY_OPEN_JOBS=false

# Max quote in USDC for auto-apply (optional)
PROVIDER_MAX_QUOTE_USDC=10.0

# Comma-separated capabilities for auto-apply (optional)
PROVIDER_CAPABILITIES=data-analysis,market-summary

# Poll interval in ms (default: 15000)
POLL_INTERVAL_MS=15000
