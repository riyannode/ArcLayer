# ── ArcLayer Runner ─────────────────────────────────────────────────────────
# Copy to .env and fill in real values.
# NEVER commit .env to git.

# Runner identity
ARCLAYER_RUNNER_ID=runner-local-001
ARCLAYER_AGENT_ID=your-agent-id
ARCLAYER_AGENT_ADDRESS=0x0000000000000000000000000000000000000000

# Runtime connector (Hermes / OpenClaw / custom)
ARCLAYER_RUNTIME_KIND=hermes
ARCLAYER_RUNTIME_ENDPOINT=http://127.0.0.1:8642
ARCLAYER_RUNTIME_RUN_PATH=/run

# Runtime auth (optional — sent as Bearer to runtime endpoint)
HERMES_API_SERVER_KEY=
OPENCLAW_API_SERVER_KEY=

# Role
ARCLAYER_DEFAULT_ROLE=provider
ARCLAYER_ALLOWED_ROLES=provider

# Global Skill
ARCLAYER_GLOBAL_SKILL_PATH=docs/ARCLAYER_GLOBAL_AGENT_SKILL.md

# Runner HTTP server
ARCLAYER_RUNNER_PORT=8787
ARCLAYER_RUNNER_DATA_DIR=.arclayer-runner

# Runner auth (REQUIRED — min 16 chars, used for Bearer token on protected routes)
ARCLAYER_RUNNER_SECRET=change-this-to-a-long-random-secret

# ArcLayer MCP bridge (existing MCP server)
ARCLAYER_MCP_BASE_URL=https://arclayers.xyz
ARCLAYER_MCP_TOKEN=

# Circle CLI
CIRCLE_CLI_BIN=circle
CIRCLE_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
CIRCLE_CHAIN=ARC-TESTNET

# Payment policy
ARCLAYER_PAYMENT_ENABLED=false
ARCLAYER_PER_TX_LIMIT_USDC=0.01
ARCLAYER_DAILY_LIMIT_USDC=1
ARCLAYER_MONTHLY_LIMIT_USDC=20
ARCLAYER_BATCH_MAX_ITEMS=10
ARCLAYER_BATCH_MAX_TOTAL_USDC=0.05
ARCLAYER_ALLOWED_X402_HOSTS=api.example.com

# ERC contract addresses
ARCLAYER_ERC8183_CONTRACT=0x0747EEf0706327138c69792bF28Cd525089e4583
ARCLAYER_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
