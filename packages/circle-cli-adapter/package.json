{
  "name": "@arclayer/circle-cli-adapter",
  "version": "0.1.1-beta.0",
  "type": "module",
  "description": "ArcLayer Circle CLI Adapter — allowlisted shell bridge to Circle CLI with input redaction and blocked dangerous commands",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyannode/ArcLayer.git",
    "directory": "packages/circle-cli-adapter"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@arclayer/runner-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
