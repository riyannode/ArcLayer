{
  "name": "@arclayer/langchain-adapter",
  "version": "0.1.0",
  "type": "module",
  "description": "LangChain adapter for ArcLayer Runner x402, receipts, ledger, and role-scoped external agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyannode/ArcLayer.git",
    "directory": "packages/langchain-adapter"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arclayer/runner-core": "workspace:^",
    "langchain": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "langchain": ">=1.0.0"
  }
}
