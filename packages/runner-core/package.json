{
  "name": "@arclayer/runner-core",
  "version": "0.1.3",
  "type": "module",
  "description": "ArcLayer Runner Core \u2014 types, Zod schemas, policy engine, receipt store, and ledger for the external agent runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyannode/ArcLayer.git",
    "directory": "packages/runner-core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
