{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclayers.xyz/schemas/payment-action.schema.json",
  "title": "ArcLayer Payment Action Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "url",
    "method",
    "maxAmountUsdc",
    "reason"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "x402_service_pay"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "body": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "maxAmountUsdc": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string"
    }
  }
}
