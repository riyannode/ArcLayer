{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclayers.xyz/schemas/agent-result.schema.json",
  "title": "ArcLayer Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "taskId",
    "agentId",
    "status"
  ],
  "$defs": {
    "paymentAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "method",
        "maxAmountUsdc",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "x402_service_pay"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "body": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "maxAmountUsdc": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "runnerId": {
      "type": "string"
    },
    "runnerKind": {
      "type": "string",
      "enum": [
        "hermes",
        "openclaw",
        "pm2-bot",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "output": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "paymentRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paymentAction"
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeRunId": {
          "type": "string"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "paymentRail": {
          "type": "string"
        },
        "paymentReceiptId": {
          "type": "string"
        },
        "erc8183JobId": {
          "type": "string"
        },
        "deliverableHash": {
          "type": "string"
        },
        "txHash": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
