{
  "name": "@arclayer/sdk",
  "version": "0.1.2",
  "type": "module",
  "description": "ArcLayer SDK — addresses, ABIs, chain config, tx builders, and protocol helpers for Arc Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyannode/ArcLayer.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "peerDependencies": {
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
