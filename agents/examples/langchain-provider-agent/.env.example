# ArcLayer Runner
ARCLAYER_RUNNER_URL=http://127.0.0.1:8787
ARCLAYER_RUNNER_SECRET=your-runner-hmac-secret

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=openai:gpt-4o

# Set "true" to enable arclayer_provider_run_and_submit tool.
# When false (default), the tool is removed via deniedTools — the model cannot call it.
ENABLE_AUTO_SUBMIT=false
