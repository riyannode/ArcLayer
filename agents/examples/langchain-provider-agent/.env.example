# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-4o

# ArcLayer Runner
ARCLAYER_RUNNER_URL=http://127.0.0.1:8787
ARCLAYER_RUNNER_SECRET=

# Provider mode
# false (default): only arclayer_provider_run_only is available
# true: arclayer_provider_run_and_submit also becomes available
ENABLE_AUTO_SUBMIT=false

# Task source
# "none": idle loop, no tasks (default)
# "static": one-shot from STATIC_PROVIDER_JOB_JSON
TASK_SOURCE=none
TASK_POLL_INTERVAL_MS=30000

# For local static testing only:
# TASK_SOURCE=static
# STATIC_PROVIDER_JOB_JSON={"taskId":"task-demo-1","jobId":"1","agentId":"agent-demo","provider":"0x0000000000000000000000000000000000000000","description":"Demo provider job","input":{"prompt":"summarize this payload"},"metadata":{"source":"static-example"}}
