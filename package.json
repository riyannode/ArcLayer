{
  "name": "arclayer",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "next": "15.5.18",
    "react": "^19",
    "react-dom": "^19"
  },
  "description": "ArcLayer monorepo root",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/console dev",
    "build": "pnpm --filter ./apps/console build",
    "lint": "pnpm --filter ./apps/console lint",
    "build:contracts": "npm --prefix contracts run build",
    "test": "npm --prefix contracts run test",
    "check": "npm run build:sdk && corepack pnpm --dir apps/console build && corepack pnpm --dir indexer build",
    "test:console": "corepack pnpm --dir apps/console run test",
    "test:indexer": "corepack pnpm --dir indexer run test",
    "test:contracts": "npm --prefix contracts run test",
    "ci": "npm run check && npm run test:console && npm run test:indexer && npm run test:contracts",
    "dev:console": "corepack pnpm --dir apps/console dev",
    "dev:indexer": "corepack pnpm --dir indexer start",
    "build:sdk": "corepack pnpm --dir sdk build",
    "dev:runner": "corepack pnpm --dir apps/arclayer-runner dev",
    "build:runner": "corepack pnpm --dir apps/arclayer-runner build",
    "start:runner": "corepack pnpm --dir apps/arclayer-runner start",
    "check:schema": "bash scripts/check-schema.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "axios": "^1.16.0",
      "ws": "^8.20.1",
      "postcss": "^8.5.0",
      "uuid": "^13.0.1"
    }
  }
}
